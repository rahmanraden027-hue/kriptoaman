# Copy to .env locally. NEVER commit .env or a keypair file.

# Mainnet RPC. Prefer a reliable private/provider RPC for signing operations.
RPC_URL=https://api.mainnet-beta.solana.com
KEYPAIR=/absolute/local/path/to/solana-operator-keypair.json
OPERATOR_PUBLIC_ADDRESS=5Fg4FVvyvSRLMapHdYVZzUCbhC8CWdENF77AfGPVAfpK

# Approved public identity and supply for the first Solana launch candidate.
# sKAM is distinct from native KAM on KAM Network and must not be marketed as 1:1 backed/bridged until independently verifiable.
TOKEN_NAME=Solana KAM
TOKEN_SYMBOL=sKAM
TOKEN_DECIMALS=9
TOKEN_SUPPLY=1000000000
METADATA_URI=https://kriptoaman.com/token/skam.json

# Filled after token creation.
TOKEN_MINT=

# Canonical Wrapped SOL (WSOL) native mint. Tooling uses the wallet's SOL balance and wraps it transactionally.
QUOTE_MINT=So11111111111111111111111111111111111111112
QUOTE_SYMBOL=SOL

# Approved initial real Raydium CPMM canary reserves in human-readable units.
# Approved by operator: 1,000,000 sKAM + 0.20 SOL.
# Mathematical opening ratio: 0.0000002 SOL per sKAM; this is not a USD price or market-value guarantee.
POOL_BASE_UI=1000000
POOL_QUOTE_UI=0.20
RAYDIUM_FEE_CONFIG_INDEX=0

# Filled after pool creation.
POOL_ID=

# One small functional swap only. The end-to-end launcher defaults to 0.001 SOL when blank
# and refuses any canary smoke input above 0.005 SOL.
SMOKE_INPUT_UI=
SMOKE_SLIPPAGE=0.01
SMOKE_DIRECTION=quote-to-token

# Optional bounded DEX Screener indexing verification window.
DEXSCREENER_MAX_ATTEMPTS=20
DEXSCREENER_RETRY_SECONDS=15

# Explicit irreversible transaction gates. Leave blank until immediately before execution.
# The full launcher requires all four values simultaneously.
CONFIRM_FULL_SKAM_LAUNCH=
CONFIRM_CREATE_TOKEN=
CONFIRM_CREATE_POOL=
CONFIRM_SMOKE_SWAP=
