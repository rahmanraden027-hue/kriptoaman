# Copy to .env locally. NEVER commit .env or a keypair file.

# Mainnet RPC. Prefer a reliable private/provider RPC for signing operations.
RPC_URL=https://api.mainnet-beta.solana.com
KEYPAIR=/absolute/local/path/to/solana-operator-keypair.json

# Approved public identity for the first Solana launch candidate.
# sKAM is distinct from native KAM on KAM Network and must not be marketed as 1:1 backed/bridged until independently verifiable.
TOKEN_NAME=Solana KAM
TOKEN_SYMBOL=sKAM
TOKEN_DECIMALS=9
TOKEN_SUPPLY=
METADATA_URI=https://example.com/token-metadata.json

# Filled after token creation.
TOKEN_MINT=

# Canonical Solana USDC mint.
QUOTE_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# Initial real Raydium CPMM reserves in human-readable units.
POOL_BASE_UI=
POOL_QUOTE_UI=
RAYDIUM_FEE_CONFIG_INDEX=0

# Filled after pool creation.
POOL_ID=

# One small functional swap per invocation.
SMOKE_INPUT_UI=
SMOKE_SLIPPAGE=0.01
SMOKE_DIRECTION=quote-to-token

# Explicit irreversible transaction gates. Leave blank until immediately before each action.
CONFIRM_CREATE_TOKEN=
CONFIRM_CREATE_POOL=
CONFIRM_SMOKE_SWAP=
