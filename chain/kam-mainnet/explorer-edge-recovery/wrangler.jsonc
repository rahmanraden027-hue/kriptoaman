{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kam-explorer-edge-recovery",
  "main": "worker.js",
  "compatibility_date": "2026-09-17",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "explorer.kriptoaman.com/*",
      "zone_name": "kriptoaman.com"
    }
  ],
  "vars": {
    "KAM_RPC_URL": "https://rpc.kriptoaman.com"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
