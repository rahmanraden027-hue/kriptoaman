{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "kam-mainnet-explorer-gateway",
  "main": "worker.js",
  "compatibility_date": "2026-09-17",
  "workers_dev": false,
  "routes": [
    { "pattern": "explorer.kriptoaman.com", "custom_domain": true }
  ],
  "secrets": {
    "required": ["KAM_EXPLORER_ORIGIN"]
  }
}
