{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "kam-mainnet-public-rpc",
  "main": "worker.js",
  "compatibility_date": "2026-08-20",
  "workers_dev": false,
  "routes": [
    { "pattern": "rpc.kriptoaman.com", "custom_domain": true }
  ],
  "vars": {
    "KAM_NETWORK_STATUS": "mainnet-candidate-not-public",
    "KAM_EXPECTED_CHAIN_ID": "0x560c",
    "KAM_RPC_ORIGIN": "https://explorer-new.kriptoaman.com/rpc"
  },
  "services": [
    {
      "binding": "KAM_EXPLORER_GATEWAY",
      "service": "kam-mainnet-explorer-cutover"
    }
  ],
  "ratelimits": [
    {
      "name": "RPC_RATE_LIMITER",
      "namespace_id": "2202801",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "RPC_HEAVY_RATE_LIMITER",
      "namespace_id": "2202802",
      "simple": { "limit": 30, "period": 60 }
    }
  ]
}
