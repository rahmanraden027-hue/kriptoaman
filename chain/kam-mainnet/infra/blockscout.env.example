# KriptoAman Mainnet Candidate — Blockscout example only
# Copy to a secure host-local environment file. Never commit real secrets.

CHAIN_ID=22028
NETWORK=KriptoAman Mainnet Candidate
SUBNETWORK=KAM
COIN=KAM
COIN_NAME=KriptoAman

# Replace with the protected RPC/sentry origin reachable from the explorer host.
ETHEREUM_JSONRPC_HTTP_URL=http://kam-rpc-origin.internal:8545/
ETHEREUM_JSONRPC_WS_URL=ws://kam-rpc-origin.internal:8546/

# Production deployments must use secure persistent database credentials.
DATABASE_URL=postgresql://CHANGE_ME:CHANGE_ME@postgres:5432/blockscout

API_V2_ENABLED=true
MIX_ENV=prod

# Do not publish explorer until RPC Chain ID and block progression have been verified.
