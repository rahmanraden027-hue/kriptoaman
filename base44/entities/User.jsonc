{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "compliance",
        "support",
        "finance",
        "auditor",
        "user"
      ],
      "default": "user"
    },
    "premium_analytics": {
      "type": "boolean",
      "default": false,
      "description": "Apakah user berlangganan Premium Crypto Analytics"
    },
    "premium_since": {
      "type": "string",
      "format": "date-time",
      "description": "Tanggal mulai langganan premium"
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "Stripe customer ID"
    },
    "stripe_subscription_id": {
      "type": "string",
      "description": "Stripe subscription ID"
    },
    "kycStatus": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "approved",
        "rejected"
      ],
      "default": "none",
      "description": "Status verifikasi KYC pengguna"
    },
    "kycData": {
      "type": "object",
      "description": "Data KYC yang disubmit pengguna"
    }
  },
  "required": []
}