{
  "name": "SecureVault",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "description": "Nama/label untuk key ini"
    },
    "category": {
      "type": "string",
      "enum": [
        "api_key",
        "secret",
        "other"
      ],
      "description": "Kategori key. DILARANG menyimpan private key, seed phrase, recovery code, atau wallet key dompet kripto di sini. Hanya API key/secret layanan pihak ketiga."
    },
    "service": {
      "type": "string",
      "description": "Nama layanan/platform (Binance, dll)"
    },
    "encryptedValue": {
      "type": "string",
      "description": "Nilai key yang terenkripsi"
    },
    "notes": {
      "type": "string",
      "description": "Catatan tambahan"
    },
    "ownerEmail": {
      "type": "string",
      "description": "Email owner"
    },
    "isVisible": {
      "type": "boolean",
      "default": false,
      "description": "Status tampilkan value"
    },
    "lastAccessedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Terakhir diakses"
    }
  },
  "required": [
    "label",
    "category",
    "encryptedValue",
    "ownerEmail"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.ownerEmail": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.ownerEmail": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.ownerEmail": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.ownerEmail": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}