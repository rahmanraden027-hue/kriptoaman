{
  "name": "LoanRepayment",
  "type": "object",
  "properties": {
    "loanId": {
      "type": "string",
      "description": "Referensi ke P2PLoan"
    },
    "borrowerEmail": {
      "type": "string",
      "description": "Email peminjam"
    },
    "amount": {
      "type": "number",
      "description": "Jumlah pembayaran"
    },
    "txHash": {
      "type": "string",
      "description": "Transaction hash dari blockchain"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "failed"
      ],
      "default": "pending",
      "description": "Status pembayaran"
    },
    "paidAt": {
      "type": "string",
      "format": "date-time",
      "description": "Waktu pembayaran"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Deskripsi tambahan untuk pencarian"
    }
  },
  "required": [
    "loanId",
    "borrowerEmail",
    "amount"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.borrowerEmail": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}