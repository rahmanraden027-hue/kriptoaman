{
  "name": "UserBalance",
  "type": "object",
  "properties": {
    "userEmail": {
      "type": "string",
      "description": "Email pengguna"
    },
    "coin": {
      "type": "string",
      "description": "Koin (USDT, SOL, IDR, dll)"
    },
    "amount": {
      "type": "number",
      "default": 0,
      "description": "Jumlah saldo (plaintext fallback, selalu 0 setelah enkripsi aktif)"
    },
    "amountEncrypted": {
      "type": "string",
      "description": "Jumlah saldo terenkripsi AES-256-GCM (iv + ciphertext base64)"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Deskripsi tambahan untuk pencarian"
    }
  },
  "required": [
    "userEmail",
    "coin",
    "amount"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.userEmail": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}