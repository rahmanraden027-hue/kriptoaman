{
  "name": "DepositRequest",
  "type": "object",
  "properties": {
    "userEmail": {
      "type": "string",
      "description": "Email pengguna"
    },
    "type": {
      "type": "string",
      "enum": [
        "crypto",
        "bank"
      ],
      "description": "Metode deposit"
    },
    "coin": {
      "type": "string",
      "description": "Koin atau IDR"
    },
    "network": {
      "type": "string",
      "description": "Jaringan blockchain (untuk kripto)"
    },
    "amountCrypto": {
      "type": "number",
      "description": "Jumlah kripto yang dideposit"
    },
    "amountIDR": {
      "type": "number",
      "description": "Jumlah IDR (untuk bank)"
    },
    "txHash": {
      "type": "string",
      "description": "Transaction hash (untuk kripto)"
    },
    "senderName": {
      "type": "string",
      "description": "Nama pengirim (untuk bank)"
    },
    "proofNote": {
      "type": "string",
      "description": "Catatan / nomor referensi"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "rejected"
      ],
      "default": "pending"
    },
    "pendingReason": {
      "type": "string",
      "description": "Alasan mengapa transaksi masih tertunda"
    },
    "adminNote": {
      "type": "string",
      "description": "Catatan admin"
    },
    "confirmedAt": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Deskripsi tambahan untuk pencarian"
    }
  },
  "required": [
    "userEmail",
    "type",
    "coin",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.userEmail": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.userEmail": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}