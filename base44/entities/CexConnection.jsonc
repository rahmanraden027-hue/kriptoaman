{
  "name": "CexConnection",
  "type": "object",
  "properties": {
    "exchange": {
      "type": "string",
      "enum": [
        "binance",
        "coinbase",
        "kraken",
        "okx",
        "bybit",
        "kucoin"
      ],
      "description": "Exchange identifier"
    },
    "label": {
      "type": "string",
      "description": "User-defined label for this connection"
    },
    "api_key": {
      "type": "string",
      "description": "Encrypted API key"
    },
    "api_secret": {
      "type": "string",
      "description": "Encrypted API secret"
    },
    "api_passphrase": {
      "type": "string",
      "description": "API passphrase (required for OKX, KuCoin)"
    },
    "last_synced": {
      "type": "string",
      "format": "date-time",
      "description": "Last successful sync timestamp"
    },
    "last_balances": {
      "type": "string",
      "description": "JSON string of last fetched balances"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "error",
        "pending"
      ],
      "default": "pending"
    },
    "error_message": {
      "type": "string",
      "description": "Last error message if status is error"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Deskripsi tambahan untuk pencarian"
    }
  },
  "required": [
    "exchange",
    "api_key",
    "api_secret"
  ]
}